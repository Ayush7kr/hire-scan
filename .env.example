# ==============================================================================
# HireScan — Environment Configuration Template (.env.example)
#
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE DJANGO SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# In production (DEBUG=False), SECRET_KEY MUST be set to a cryptographically
# secure, unique string (50+ random characters).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-in-production-!@#$%^&*()

# Set DEBUG=False for production deployments.
# Never run with DEBUG=True in production.
DEBUG=True

# Comma-separated list of valid hostnames or IP addresses this site can serve.
# In production, specify your exact domain names (e.g. hirescan.yourdomain.com).
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,web

# Comma-separated list of trusted origins for unsafe requests (POST, PUT, DELETE).
# Required when accessing via domain name or reverse proxy (e.g. https://hirescan.yourdomain.com).
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Set DB_ENGINE=postgresql to use PostgreSQL, or leave blank/sqlite for SQLite.
# Options: 'sqlite' | 'postgresql'
DB_ENGINE=sqlite

# Standard 12-factor DATABASE_URL (optional alternative to discrete DB_* settings):
# Example: postgres://postgres:your_db_password@db:5432/hirescan_db
# DATABASE_URL=

# PostgreSQL Connection Parameters (used if DB_ENGINE=postgresql and DATABASE_URL is unset):
DB_NAME=hirescan_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Database Connection Pool & Persistence (seconds to keep connection open):
DB_CONN_MAX_AGE=600

# PostgreSQL Connection Timeout in seconds:
DB_CONNECT_TIMEOUT=10

# SQLite database file name (used when DB_ENGINE=sqlite):
SQLITE_DB_NAME=db.sqlite3

# ─────────────────────────────────────────────────────────────────────────────
# 3. EMAIL & OTP AUTHENTICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# EMAIL BACKEND OPTIONS:
# Option A (Local Development Default):
#   Prints OTP emails directly to your active terminal console.
#   No SMTP setup or external network connection required.
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Option B (Live Email Delivery to Inboxes via SMTP):
#   Delivers real emails over network to candidates' inboxes.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─────────────────────────────────────────────────────────────
# SMTP Server Configuration (used when EMAIL_BACKEND is smtp):
# ─────────────────────────────────────────────────────────────
# For Gmail SMTP:
#   1. Enable "2-Step Verification" on your Google Account:
#      https://myaccount.google.com/security
#   2. Generate a 16-character App Password (Select App: "Mail", Device: "Other"):
#      https://myaccount.google.com/apppasswords
#   3. Enter your full Gmail address in EMAIL_HOST_USER.
#   4. Enter the generated 16-character App Password in EMAIL_HOST_PASSWORD
#      (Do NOT use your personal Google account login password!).
#   5. Set EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True.
#
# For SendGrid / Mailgun / Amazon SES:
#   EMAIL_HOST=smtp.sendgrid.net (or your provider host)
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=apikey (or provider username)
#   EMAIL_HOST_PASSWORD=your-secret-api-key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_TIMEOUT=10

# Default email sender display name and address:
# NOTE: When using Gmail SMTP, this MUST match or align with EMAIL_HOST_USER
DEFAULT_FROM_EMAIL=HireScan Assessments <noreply@yourdomain.com>

# Candidate OTP Security Lifecycles:
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
# Maximum OTP request attempts per minute per IP address (rate limiting against abuse):
OTP_IP_RATE_LIMIT_PER_MINUTE=5

# ─────────────────────────────────────────────────────────────────────────────
# 4. SESSION & COOKIE SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Session cookie lifetime in seconds (86400 = 24 hours):
SESSION_COOKIE_AGE=86400

# Cookie HTTPS transmission flags:
# In production with HTTPS, both MUST be set to True.
# In local HTTP development, set to False so sessions work over plain HTTP.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ─────────────────────────────────────────────────────────────────────────────
# 5. PRODUCTION REVERSE PROXY & HTTPS HARDENING
# ─────────────────────────────────────────────────────────────────────────────
# Enable automatic redirect from HTTP to HTTPS (set True only when serving HTTPS):
SECURE_SSL_REDIRECT=False

# Trust X-Forwarded-Proto header from known reverse proxy (e.g. Nginx, AWS ALB):
# Set True if TLS terminates at Nginx or an external load balancer.
SECURE_PROXY_SSL_HEADER=False

# Trust X-Forwarded-Host and Port from reverse proxy:
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PORT=False

# HTTP Strict Transport Security (HSTS) duration in seconds:
# Standard production: 31536000 (1 year). Set 0 during staging / initial testing.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ─────────────────────────────────────────────────────────────────────────────
# 6. APPLICATION LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────────────────
# Log severity levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# 7. DOCKER & GUNICORN SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# Host port to bind Nginx when running via docker-compose:
HOST_HTTP_PORT=80

# Gunicorn concurrency settings:
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90
